+            } else if let map = value as? [String: Any] {
+                for child in map.values { try inspectStructure(child) }
+            } else if let list = value as? [Any] {
+                for child in list { try inspectStructure(child) }
+            }
+        }
+        for entry in structureRows { try inspectStructure(entry) }
+
+        var recordLimits = MenuCaptureDiagnostics.Limits()
+        recordLimits.records = 3
+        let capped = try logger("records", limits: recordLimits)
+        var accepted = 0
+        for _ in 0..<20 { if capped.record(.input, .observed) { accepted += 1 } }
+        try noProbe(capped, "An exhausted record budget must prevent optional structure queries")
+        try check(accepted == 2 && capped.finish(), "The 200-record production cap includes the header")
+        try check(try lines(capped).count == 3, "No record beyond the configured cap")
+        try check(!capped.record(.input, .observed), "No entries after normal finish")
+
+        var byteLimits = MenuCaptureDiagnostics.Limits()
+        byteLimits.bytes = 320
+        let byteQueue = DispatchQueue(label: "TileLauncher.menu-diagnostic-validation-byte-cap")
+        let bytes = try logger("bytes", limits: byteLimits, queue: byteQueue)
+        for _ in 0..<20 { bytes.record(.catalog, .incomplete, values: .init(nodeCount: 800, nodeLimit: true)) }
+        byteQueue.sync {}
+        try noProbe(bytes, "A writer's byte-budget failure must prevent optional structure queries")
+        try check(bytes.finish(), "Byte-limited logger drains")
+        try check(try Data(contentsOf: bytes.fileURL).count <= byteLimits.bytes, "Never exceed byte budget")
+        _ = try lines(bytes) // Writes stop before an oversized line, not halfway through one.
+
+        var now: TimeInterval = 100
+        let timed = try logger("time", clock: { now })
+        try check(timed.canAcceptRecords(), "A fresh recorder must be eligible before expiry")
+        now = 99
+        try check(!timed.record(.input, .observed), "A backwards clock is not serialized")
+        now = 701
+        try check(!timed.record(.input, .observed), "Stop accepting after ten minutes")
+        try noProbe(timed, "An expired recording window must prevent optional structure queries")
+        try check(timed.finish(), "Expired logger drains previously accepted records")
+        try check(try lines(timed).count == 1, "Only the accepted start record remains")
+
+        var pendingLimits = MenuCaptureDiagnostics.Limits()
+        pendingLimits.pending = 2
+        let paused = DispatchQueue(label: "TileLauncher.menu-diagnostic-validation-paused")
+        paused.suspend()
+        var resumePending = true
+        defer { if resumePending { paused.resume() } }
+        let bounded = try logger("pending", limits: pendingLimits, queue: paused)
+        let first = bounded.record(.input, .observed)
+        let overflow = bounded.record(.input, .observed)
+        try noProbe(bounded, "A full pending-write queue must prevent optional structure queries without waiting")
+        let waiting = bounded.finish(timeout: 0)
+        paused.resume()
+        resumePending = false
+        try check(first && !overflow && !waiting, "Writer backlog is bounded and enqueue never waits for disk")
+        try check(bounded.finish(), "Resuming the writer flushes exactly the accepted backlog")
+        try check(try lines(bounded).count == 2, "Overflow records are not queued")
+
+        print("Menu diagnostics: no-opt-in creates no file; unique0600 files preserve existing logs; typed metadata contains no free text.")
+        print("Menu diagnostics: bounded pending writes, record/byte/time caps, and normal-termination flush verified with synthetic fixtures only.")
+    }
+}
+#endif
diff --git a/Sources/TileLauncher/MenuHelpCatalogPolicyValidation.swift b/Sources/TileLauncher/MenuHelpCatalogPolicyValidation.swift
new file mode 100644
index 0000000..7d6ab1a
--- /dev/null
+++ b/Sources/TileLauncher/MenuHelpCatalogPolicyValidation.swift
@@ -0,0 +1,105 @@
+#if TILE_LAUNCHER_DIAGNOSTICS || TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+import ApplicationServices
+import CoreFoundation
+import DeckCore
+import Foundation
+
+/// The production role reader and traversal, with injected CF values and child
+/// lists. Runs in both flag-off debug and diagnostic builds; no AX queries.
+enum MenuHelpCatalogPolicyValidation {
+    private enum Result: Equatable { case value(MenuCatalogTraversal.Role), unavailable, failure }
+    private static func result(_ read: MenuCatalogTraversal.Read<MenuCatalogTraversal.Role>) -> Result {
+        switch read {
+        case .value(let role): return .value(role)
+        case .unavailable: return .unavailable
+        case .failure: return .failure
+        }
+    }
+
+    static func run() throws {
+        func check(_ condition: @autoclosure () -> Bool, _ message: String) throws {
+            guard condition() else {
+                throw NSError(domain: "TileLauncher.MenuHelpCatalogPolicyValidation", code: 1,
+                              userInfo: [NSLocalizedDescriptionKey: message])
+            }
+        }
+        let accepted: [(String, MenuCatalogTraversal.Role)] = [
+            (kAXMenuBarItemRole, .menuBarItem), (kAXMenuItemRole, .menuItem), (kAXMenuRole, .container),
+            (kAXGroupRole, .structuralGroup), (kAXButtonRole, .controlLeaf)]
+        var cases: [(AXError, CFTypeRef?, Result)] = accepted.map { (.success, $0.0 as NSString, .value($0.1)) }
+        cases += [(.attributeUnsupported, kAXGroupRole as NSString, .unavailable),
+                  (.noValue, kAXButtonRole as NSString, .unavailable),
+                  (.cannotComplete, kAXGroupRole as NSString, .failure), (.success, nil, .failure),
+                  (.success, NSNumber(value: 7), .failure), (.success, kCFBooleanTrue, .failure),
+                  (.success, NSArray(), .failure), (.success, kAXImageRole as NSString, .failure),
+                  (.success, "private custom role fixture" as NSString, .failure)]
+        for (error, value, expected) in cases {
+            var calls = 0
+            let plain = MenuHelpCatalogRoleRead.read { calls += 1; return (error, value) }
+            try check(result(plain) == expected && calls == 1,
+                      "Shared production role mapping must retain one provider read and its exact outcome")
+            #if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+            var diagnosticCalls = 0, reports = 0
+            let diagnostic = MenuHelpRoleRead.read({ diagnosticCalls += 1; return (error, value) }, report: { _ in reports += 1 })
+            try check(result(diagnostic) == result(plain) && diagnosticCalls == 1,
+                      "Diagnostic ON and production role readers must share decisions and query counts")
+            switch expected {
+            case .value: try check(reports == 0, "Accepted Group/Button raw roles must not trigger unsupported-role probes")
+            case .failure, .unavailable: try check(reports == 1, "A rejected role reports exactly once")
+            }
+            #endif
+        }
+        for (_, role) in accepted {
+            try check(MenuHelpChildrenPolicy.isUnsupportedLeaf(.attributeUnsupported, menuItem: role == .menuItem)
+                      == (role == .menuItem), "Existing unsupported-child compatibility applies only to known MenuItem")
+            try check(!MenuHelpChildrenPolicy.isUnsupportedLeaf(.noValue, menuItem: role == .menuItem)
+                      && !MenuHelpChildrenPolicy.isUnsupportedLeaf(.cannotComplete, menuItem: role == .menuItem),
+                      "Neither Groups nor Buttons become proven leaves after missing/error children")
+            #if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+            var reads: [String] = []
+            let unsupported = MenuHelpChildrenRead.read(leafAllowed: role == .menuItem, limit: 100,
+                count: { reads.append("count"); return (.attributeUnsupported, 0) },
+                canCopy: { reads.append("canCopy"); return true },
+                copy: { _ in reads.append("copy"); return (.success, nil) }, report: { _ in })
+            if role == .menuItem {
+                guard case .value(let children) = unsupported, children.isEmpty else {
+                    throw NSError(domain: "TileLauncher.MenuHelpCatalogPolicyValidation", code: 2)
+                }
+            } else {
+                guard case .unavailable = unsupported else {
+                    throw NSError(domain: "TileLauncher.MenuHelpCatalogPolicyValidation", code: 3)
+                }
+            }
+            try check(reads == ["count"], "Unsupported child reads must stop before copy, without granting new-role leaf compatibility")
+            #endif
+        }
+
+        // The observed shape exercises the actual role adapter in ordinary
+        // builds too: no opt-in or diagnostic helper participates in acceptance.
+        let roles: [Int: String] = [1: kAXMenuBarItemRole, 2: kAXMenuRole, 3: kAXGroupRole, 4: kAXGroupRole,
+                                    5: kAXButtonRole, 6: kAXButtonRole, 7: kAXButtonRole, 8: kAXButtonRole,
+                                    9: kAXButtonRole, 10: kAXButtonRole, 11: kAXButtonRole, 12: kAXMenuItemRole]
+        let children = [1: [2], 2: [3, 12], 3: [4], 4: Array(5...11)]
+        var roleReads = 0, childReads = 0
+        var titleReads: [Int] = []
+        let outcome = MenuCatalogTraversal.scan(roots: { .value([.init(node: 1)]) },
+            role: { node in
+                MenuHelpCatalogRoleRead.read { roleReads += 1; return (.success, roles[node]! as NSString) }
+            }, title: { node in
+                titleReads.append(node)
+                return .value(node == 1 ? "File" : "TSV…")
+            }, children: { node in childReads += 1; return .value(children[node] ?? []) },
+            hasTime: { true }, isCancelled: { false })
+        guard case .complete(let entries, let stats) = outcome else {
+            throw NSError(domain: "TileLauncher.MenuHelpCatalogPolicyValidation", code: 4,
+                          userInfo: [NSLocalizedDescriptionKey: "Production mapping rejected the observed valid Group/Button structure"])
+        }
+        try check(entries.map(\.path) == [["File", "TSV…"]] && entries.map(\.node) == [12],
+                  "Only real MenuItem leaves may be emitted, after all structural descendants are checked")
+        try check(roleReads == 12 && childReads == 12 && stats.nodes == 12 && titleReads == [1, 12],
+                  "New roles share the normal traversal, without Group/Button titles, extra queries or a second scan")
+
+        print("Menu Help catalog policy: shared native role mapping and observed Group/Button traversal preserve candidate scope and single-read behavior with no AX queries.")
+    }
+}
+#endif
diff --git a/Sources/TileLauncher/MenuHelpCatalogRoleRead.swift b/Sources/TileLauncher/MenuHelpCatalogRoleRead.swift
new file mode 100644
index 0000000..68f9619
--- /dev/null
+++ b/Sources/TileLauncher/MenuHelpCatalogRoleRead.swift
@@ -0,0 +1,51 @@
+import ApplicationServices
+import DeckCore
+
+/// The deferred Help catalog's single AXRole read and role mapping, shared by
+/// the flag-off and diagnostic builds so they cannot drift. One `copy` call;
+/// attributeUnsupported/noValue is unavailable, any other error or a missing /
+/// non-string value fails, and only five AX roles are accepted:
+/// AXMenuBarItem, AXMenuItem, AXMenu (container), AXGroup (structural group)
+/// and AXButton (control leaf). Placement of groups/controls is validated by
+/// `MenuCatalogTraversal.scan` against the actual parent.
+enum MenuHelpCatalogRoleRead {
+    enum Result: Equatable {
+        case accepted(MenuCatalogTraversal.Role)
+        /// attributeUnsupported or noValue.
+        case unavailable(AXError)
+        case error(AXError)
+        case missingValue
+        case nonString
+        /// A string role outside the five; kept only for in-process classification.
+        case unsupported(String)
+    }
+    static func role(forRaw raw: String) -> MenuCatalogTraversal.Role? {
+        switch raw {
+        case kAXMenuBarItemRole: return .menuBarItem
+        case kAXMenuItemRole: return .menuItem
+        case kAXMenuRole: return .container
+        case kAXGroupRole: return .structuralGroup
+        case kAXButtonRole: return .controlLeaf
+        default: return nil
+        }
+    }
+    static func classify(error: AXError, value: CFTypeRef?) -> Result {
+        if error == .attributeUnsupported || error == .noValue { return .unavailable(error) }
+        guard error == .success else { return .error(error) }
+        guard let value else { return .missingValue }
+        guard let raw = value as? String else { return .nonString }
+        guard let role = role(forRaw: raw) else { return .unsupported(raw) }
+        return .accepted(role)
+    }
+    static func read(_ copy: () -> (AXError, CFTypeRef?)) -> MenuCatalogTraversal.Read<MenuCatalogTraversal.Role> {
+        let (error, value) = copy()
+        return outcome(classify(error: error, value: value))
+    }
+    static func outcome(_ result: Result) -> MenuCatalogTraversal.Read<MenuCatalogTraversal.Role> {
+        switch result {
+        case .accepted(let role): return .value(role)
+        case .unavailable: return .unavailable
+        case .error, .missingValue, .nonString, .unsupported: return .failure
+        }
+    }
+}
diff --git a/Sources/TileLauncher/MenuHelpChildrenRead.swift b/Sources/TileLauncher/MenuHelpChildrenRead.swift
new file mode 100644
index 0000000..2085b85
--- /dev/null
+++ b/Sources/TileLauncher/MenuHelpChildrenRead.swift
@@ -0,0 +1,110 @@
+#if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+import ApplicationServices
+import CoreFoundation
+import DeckCore
+import Foundation
+
+/// R368 diagnostic build only: the dev79 children read for the deferred Help
+/// resolver, step for step, with the first non-success branch reported as a
+/// typed trace. The decisions, order, short-circuits and AX calls are exactly
+/// those of the flag-off `elements` body; the AX calls are supplied by the
+/// caller. A trace carries only a branch, AX error codes, counts and an index —
+/// never titles, values, objects or coordinates.
+enum MenuHelpChildrenRead {
+    enum Failure: String, Encodable, Equatable {
+        /// AXUIElementGetAttributeValueCount returned another error.
+        case countError
+        /// The count call succeeded with a negative count.
+        case negativeCount
+        /// AXChildren unsupported/noValue where a leaf is not allowed.
+        case countUnavailable
+        /// The deadline or cancellation stopped the read before the copy.
+        case copyNotAttempted
+        /// AXUIElementCopyAttributeValues returned an error.
+        case copyError
+        /// The copy succeeded without an array.
+        case missingArray
+        /// The array could not be bridged to objects.
+        case arrayDecode
+        /// The bridged array did not have exactly the requested count.
+        case countMismatch
+        /// An item was not an AXUIElement.
+        case elementType
+    }
+    struct Trace: Equatable {
+        var failure: Failure
+        var countErrorCode: Int? = nil
+        var copyErrorCode: Int? = nil
+        var reportedCount: Int? = nil
+        var requestedCount: Int? = nil
+        var returnedCount: Int? = nil
+        var invalidIndex: Int? = nil
+    }
+
+    /// `report` is called at most once, only for a failure. A normal childless
+    /// leaf (`MenuHelpChildrenPolicy.isUnsupportedLeaf`: attributeUnsupported on
+    /// a known menu item, `leafAllowed`) and a zero count are not traced.
+    static func read(leafAllowed: Bool, limit: Int,
+                     count: () -> (AXError, CFIndex),
+                     canCopy: () -> Bool,
+                     copy: (CFIndex) -> (AXError, CFArray?),
+                     decode: (CFArray) -> [AnyObject]? = { $0 as? [AnyObject] },
+                     isElement: (AnyObject) -> Bool = { CFGetTypeID($0 as CFTypeRef) == AXUIElementGetTypeID() },
+                     report: (Trace) -> Void) -> MenuCatalogTraversal.Read<[AXUIElement]> {
+        let (countResult, reported) = count()
+        if countResult == .attributeUnsupported || countResult == .noValue {
+            // Same policy as the flag-off body: only an explicitly unsupported
+            // AXChildren on a known menu item is a leaf; noValue is not.
+            if MenuHelpChildrenPolicy.isUnsupportedLeaf(countResult, menuItem: leafAllowed) { return .value([]) }
+            report(Trace(failure: .countUnavailable, countErrorCode: Int(countResult.rawValue)))
+            return .unavailable
+        }
+        guard countResult == .success else {
+            report(Trace(failure: .countError, countErrorCode: Int(countResult.rawValue)))
+            return .failure
+        }
+        guard reported >= 0 else {
+            report(Trace(failure: .negativeCount, reportedCount: Int(reported)))
+            return .failure
+        }
+        if reported == 0 { return .value([]) }
+        guard canCopy() else {
+            report(Trace(failure: .copyNotAttempted, reportedCount: Int(reported)))
+            return .failure
+        }
+        // Beyond the cap, only cap + 1 is fetched so the traversal reports childLimit.
+        let requested = min(reported, CFIndex(limit + 1))
+        let (copyResult, values) = copy(requested)
+        guard copyResult == .success else {
+            report(Trace(failure: .copyError, copyErrorCode: Int(copyResult.rawValue),
+                         reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard let values else {
+            report(Trace(failure: .missingArray, reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard let items = decode(values) else {
+            report(Trace(failure: .arrayDecode, reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard items.count == requested else {
+            report(Trace(failure: .countMismatch, reportedCount: Int(reported), requestedCount: Int(requested),
+                         returnedCount: items.count))
+            return .failure
+        }
+        var children: [AXUIElement] = []
+        children.reserveCapacity(items.count)
+        for (index, item) in items.enumerated() {
+            // Never cast an item the predicate rejected.
+            guard isElement(item) else {
+                report(Trace(failure: .elementType, reportedCount: Int(reported), requestedCount: Int(requested),
+                             returnedCount: items.count, invalidIndex: index))
+                return .failure
+            }
+            children.append(item as! AXUIElement)
+        }
+        return .value(children)
+    }
+}
+#endif
diff --git a/Sources/TileLauncher/MenuHelpChildrenReadValidation.swift b/Sources/TileLauncher/MenuHelpChildrenReadValidation.swift
