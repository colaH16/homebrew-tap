+        guard let path = menuPath(table) else { trace.failure = .menuPath; return nil }
+        guard path.count == 1, MenuCapturePolicy.isHelpMenuTitle(path[0]) else {
+            trace.failure = .helpOwnership; return nil
+        }
+        trace.helpOwned = true
