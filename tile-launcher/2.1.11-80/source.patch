@@ -0,0 +1,148 @@
+#if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+import Darwin
+import Foundation
+import ApplicationServices
+
+/// Synthetic file/queue fixtures only. Does not observe apps, install a global
+/// input monitor, query AX, open a panel or acquire the production instance.
+enum MenuCaptureDiagnosticsValidation {
+    static func verify(to directory: URL) throws {
+        let fm = FileManager.default
+        let root = directory.appendingPathComponent("menu-capture-" + UUID().uuidString, isDirectory: true)
+        try fm.createDirectory(at: root, withIntermediateDirectories: true)
+        func check(_ condition: @autoclosure () throws -> Bool, _ message: String) throws {
+            guard try condition() else {
+                throw NSError(domain: "TileLauncher.MenuCaptureDiagnosticsValidation", code: 1,
+                              userInfo: [NSLocalizedDescriptionKey: message])
+            }
+        }
+        func logger(_ folder: String, limits: MenuCaptureDiagnostics.Limits = .init(),
+                    clock: @escaping () -> TimeInterval = { ProcessInfo.processInfo.systemUptime },
+                    queue: DispatchQueue? = nil) throws -> MenuCaptureDiagnostics {
+            let target = root.appendingPathComponent(folder, isDirectory: true)
+            try fm.createDirectory(at: target, withIntermediateDirectories: true)
+            guard let value = MenuCaptureDiagnostics(directory: target, limits: limits, clock: clock, writerQueue: queue) else {
+                throw NSError(domain: "TileLauncher.MenuCaptureDiagnosticsValidation", code: 2)
+            }
+            return value
+        }
+        func lines(_ value: MenuCaptureDiagnostics) throws -> [[String: Any]] {
+            try Data(contentsOf: value.fileURL).split(separator: 0x0a).map {
+                guard let result = try JSONSerialization.jsonObject(with: Data($0)) as? [String: Any] else {
+                    throw NSError(domain: "TileLauncher.MenuCaptureDiagnosticsValidation", code: 3)
+                }
+                return result
+            }
+        }
+
+        let noOpt = root.appendingPathComponent("not-opted-in", isDirectory: true)
+        try fm.createDirectory(at: noOpt, withIntermediateDirectories: true)
+        try check(MenuCaptureDiagnostics.makeIfRequested(arguments: ["TileLauncher"], directory: noOpt) == nil,
+                  "No diagnostic logger without the explicit execution argument")
+        try check(try fm.contentsOfDirectory(atPath: noOpt.path).isEmpty,
+                  "An invocation without opt-in must create no file")
+
+        let a = try logger("unique")
+        let existing = Data("existing-file-preserved".utf8)
+        let sentinel = a.fileURL.deletingLastPathComponent().appendingPathComponent("tile-launcher-menu-capture-existing")
+        try existing.write(to: sentinel)
+        guard let b = MenuCaptureDiagnostics(directory: a.fileURL.deletingLastPathComponent()) else {
+            throw NSError(domain: "TileLauncher.MenuCaptureDiagnosticsValidation", code: 4)
+        }
+        try check(a.fileURL != b.fileURL, "Every run must create a unique file")
+        let permission = try fm.attributesOfItem(atPath: a.fileURL.path)[.posixPermissions] as? NSNumber
+        try check(permission?.intValue == 0o600, "Diagnostic file permissions must be 0600")
+        a.updateContext(.init(generation: 4, helpSession: 2))
+        let origin = a.stamp()
+        try check(a.record(.input, .accepted, origin: origin,
+                           values: .init(input: .mouseUp, role: .row, ageMilliseconds: 4,
+                                         cellCount: 1, labelCount: 1, frameContains: true)),
+                  "Accept a typed metadata record")
+        try check(a.finish() && b.finish(), "Normal shutdown must flush accepted records")
+        try check(try Data(contentsOf: sentinel) == existing, "Existing files must remain unchanged")
+        let metadata = try lines(a)
+        try check(metadata.count == 2, "Flush includes the header and accepted metadata")
+        let allowedKeys: Set<String> = ["schema", "ordinal", "elapsedMilliseconds", "stage", "outcome", "context", "origin", "values"]
+        let allowedStrings: Set<String> = ["started", "observed", "input", "accepted", "mouseUp", "row"]
+        func inspect(_ value: Any) throws {
+            if let text = value as? String {
+                try check(allowedStrings.contains(text), "Only enum values may appear as strings")
+            } else if let map = value as? [String: Any] {
+                for child in map.values { try inspect(child) }
+            } else if let list = value as? [Any] {
+                for child in list { try inspect(child) }
+            }
+        }
+        for entry in metadata {
+            try check(Set(entry.keys) == allowedKeys || Set(entry.keys) == allowedKeys.subtracting(["origin"]),
+                      "Only the fixed schema is serialized")
+            try inspect(entry)
+            let elapsed = entry["elapsedMilliseconds"] as? Int ?? -1
+            try check((0...600_000).contains(elapsed), "Use relative bounded time only")
+        }
+
+        let childRead = try logger("child-read")
+        let copyError = Int(AXError.cannotComplete.rawValue)
+        try check(childRead.record(.deferred, .incomplete,
+                                   values: .init(childrenFailure: .copyError, childrenCopyError: copyError,
+                                                 childrenReportedCount: 3, childrenRequestedCount: 3)),
+                  "Accept a typed child-read failure")
+        try check(childRead.finish(), "Child-read metadata flushes")
+        let childRows = try lines(childRead)
+        try check(childRows.count == 2, "A failure adds one event, not one per node")
+        let childValues = childRows.last?["values"] as? [String: Any] ?? [:]
+        try check(Set(childValues.keys) == ["childrenFailure", "childrenCopyError", "childrenReportedCount", "childrenRequestedCount"],
+                  "Unreached stages and raw values must not enter the child-read record")
+        try check(childValues["childrenFailure"] as? String == "copyError"
+                  && childValues["childrenCopyError"] as? Int == copyError
+                  && childValues["childrenReportedCount"] as? Int == 3
+                  && childValues["childrenRequestedCount"] as? Int == 3,
+                  "Keep the failure enum, signed AX code and counts in their typed fields")
+
+        var recordLimits = MenuCaptureDiagnostics.Limits()
+        recordLimits.records = 3
+        let capped = try logger("records", limits: recordLimits)
+        var accepted = 0
+        for _ in 0..<20 { if capped.record(.input, .observed) { accepted += 1 } }
+        try check(accepted == 2 && capped.finish(), "The 200-record production cap includes the header")
+        try check(try lines(capped).count == 3, "No record beyond the configured cap")
+        try check(!capped.record(.input, .observed), "No entries after normal finish")
+
+        var byteLimits = MenuCaptureDiagnostics.Limits()
+        byteLimits.bytes = 320
+        let bytes = try logger("bytes", limits: byteLimits)
+        for _ in 0..<20 { bytes.record(.catalog, .incomplete, values: .init(nodeCount: 800, nodeLimit: true)) }
+        try check(bytes.finish(), "Byte-limited logger drains")
+        try check(try Data(contentsOf: bytes.fileURL).count <= byteLimits.bytes, "Never exceed byte budget")
+        _ = try lines(bytes) // Writes stop before an oversized line, not halfway through one.
+
+        var now: TimeInterval = 100
+        let timed = try logger("time", clock: { now })
+        now = 99
+        try check(!timed.record(.input, .observed), "A backwards clock is not serialized")
+        now = 701
+        try check(!timed.record(.input, .observed), "Stop accepting after ten minutes")
+        try check(timed.finish(), "Expired logger drains previously accepted records")
+        try check(try lines(timed).count == 1, "Only the accepted start record remains")
+
+        var pendingLimits = MenuCaptureDiagnostics.Limits()
+        pendingLimits.pending = 2
+        let paused = DispatchQueue(label: "TileLauncher.menu-diagnostic-validation-paused")
+        paused.suspend()
+        var resumePending = true
+        defer { if resumePending { paused.resume() } }
+        let bounded = try logger("pending", limits: pendingLimits, queue: paused)
+        let first = bounded.record(.input, .observed)
+        let overflow = bounded.record(.input, .observed)
+        let waiting = bounded.finish(timeout: 0)
+        paused.resume()
+        resumePending = false
+        try check(first && !overflow && !waiting, "Writer backlog is bounded and enqueue never waits for disk")
+        try check(bounded.finish(), "Resuming the writer flushes exactly the accepted backlog")
+        try check(try lines(bounded).count == 2, "Overflow records are not queued")
+
+        print("Menu diagnostics: no-opt-in creates no file; unique0600 files preserve existing logs; typed metadata contains no free text.")
+        print("Menu diagnostics: bounded pending writes, record/byte/time caps, and normal-termination flush verified with synthetic fixtures only.")
+    }
+}
+#endif
diff --git a/Sources/TileLauncher/MenuHelpChildrenRead.swift b/Sources/TileLauncher/MenuHelpChildrenRead.swift
new file mode 100644
index 0000000..2085b85
--- /dev/null
+++ b/Sources/TileLauncher/MenuHelpChildrenRead.swift
@@ -0,0 +1,110 @@
+#if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+import ApplicationServices
+import CoreFoundation
+import DeckCore
+import Foundation
+
+/// R368 diagnostic build only: the dev79 children read for the deferred Help
+/// resolver, step for step, with the first non-success branch reported as a
+/// typed trace. The decisions, order, short-circuits and AX calls are exactly
+/// those of the flag-off `elements` body; the AX calls are supplied by the
+/// caller. A trace carries only a branch, AX error codes, counts and an index —
+/// never titles, values, objects or coordinates.
+enum MenuHelpChildrenRead {
+    enum Failure: String, Encodable, Equatable {
+        /// AXUIElementGetAttributeValueCount returned another error.
+        case countError
+        /// The count call succeeded with a negative count.
+        case negativeCount
+        /// AXChildren unsupported/noValue where a leaf is not allowed.
+        case countUnavailable
+        /// The deadline or cancellation stopped the read before the copy.
+        case copyNotAttempted
+        /// AXUIElementCopyAttributeValues returned an error.
+        case copyError
+        /// The copy succeeded without an array.
+        case missingArray
+        /// The array could not be bridged to objects.
+        case arrayDecode
+        /// The bridged array did not have exactly the requested count.
+        case countMismatch
+        /// An item was not an AXUIElement.
+        case elementType
+    }
+    struct Trace: Equatable {
+        var failure: Failure
+        var countErrorCode: Int? = nil
+        var copyErrorCode: Int? = nil
+        var reportedCount: Int? = nil
+        var requestedCount: Int? = nil
+        var returnedCount: Int? = nil
+        var invalidIndex: Int? = nil
+    }
+
+    /// `report` is called at most once, only for a failure. A normal childless
+    /// leaf (`MenuHelpChildrenPolicy.isUnsupportedLeaf`: attributeUnsupported on
+    /// a known menu item, `leafAllowed`) and a zero count are not traced.
+    static func read(leafAllowed: Bool, limit: Int,
+                     count: () -> (AXError, CFIndex),
+                     canCopy: () -> Bool,
+                     copy: (CFIndex) -> (AXError, CFArray?),
+                     decode: (CFArray) -> [AnyObject]? = { $0 as? [AnyObject] },
+                     isElement: (AnyObject) -> Bool = { CFGetTypeID($0 as CFTypeRef) == AXUIElementGetTypeID() },
+                     report: (Trace) -> Void) -> MenuCatalogTraversal.Read<[AXUIElement]> {
+        let (countResult, reported) = count()
+        if countResult == .attributeUnsupported || countResult == .noValue {
+            // Same policy as the flag-off body: only an explicitly unsupported
+            // AXChildren on a known menu item is a leaf; noValue is not.
+            if MenuHelpChildrenPolicy.isUnsupportedLeaf(countResult, menuItem: leafAllowed) { return .value([]) }
+            report(Trace(failure: .countUnavailable, countErrorCode: Int(countResult.rawValue)))
+            return .unavailable
+        }
+        guard countResult == .success else {
+            report(Trace(failure: .countError, countErrorCode: Int(countResult.rawValue)))
+            return .failure
+        }
+        guard reported >= 0 else {
+            report(Trace(failure: .negativeCount, reportedCount: Int(reported)))
+            return .failure
+        }
+        if reported == 0 { return .value([]) }
+        guard canCopy() else {
+            report(Trace(failure: .copyNotAttempted, reportedCount: Int(reported)))
+            return .failure
+        }
+        // Beyond the cap, only cap + 1 is fetched so the traversal reports childLimit.
+        let requested = min(reported, CFIndex(limit + 1))
+        let (copyResult, values) = copy(requested)
+        guard copyResult == .success else {
+            report(Trace(failure: .copyError, copyErrorCode: Int(copyResult.rawValue),
+                         reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard let values else {
+            report(Trace(failure: .missingArray, reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard let items = decode(values) else {
+            report(Trace(failure: .arrayDecode, reportedCount: Int(reported), requestedCount: Int(requested)))
+            return .failure
+        }
+        guard items.count == requested else {
+            report(Trace(failure: .countMismatch, reportedCount: Int(reported), requestedCount: Int(requested),
+                         returnedCount: items.count))
+            return .failure
+        }
+        var children: [AXUIElement] = []
+        children.reserveCapacity(items.count)
+        for (index, item) in items.enumerated() {
+            // Never cast an item the predicate rejected.
+            guard isElement(item) else {
+                report(Trace(failure: .elementType, reportedCount: Int(reported), requestedCount: Int(requested),
+                             returnedCount: items.count, invalidIndex: index))
+                return .failure
+            }
+            children.append(item as! AXUIElement)
+        }
+        return .value(children)
+    }
+}
+#endif
diff --git a/Sources/TileLauncher/MenuHelpChildrenReadValidation.swift b/Sources/TileLauncher/MenuHelpChildrenReadValidation.swift
new file mode 100644
index 0000000..87a8c42
--- /dev/null
+++ b/Sources/TileLauncher/MenuHelpChildrenReadValidation.swift
@@ -0,0 +1,175 @@
+#if TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS
+import ApplicationServices
+import CoreFoundation
+import Darwin
+import DeckCore
+import Foundation
+
+/// Exercises the same diagnostic-ON child reader used by the resolver. AX
+/// handles are created locally as opaque values only: no AX messages, app
+/// observation, actions, event monitors or production instance are involved.
+enum MenuHelpChildrenReadValidation {
+    private struct Fixture {
+        var leafAllowed = false
+        var limit = 100
+        var countError = AXError.success
+        var count: CFIndex = 2
+        var canCopy = true
+        var copyError = AXError.success
+        var array: CFArray?
+        var decodeFails = false
+    }
+    private enum ResultKind: Equatable { case values(Int), unavailable, failure }
+    private struct Observation {
+        let result: ResultKind
+        let calls: [String]
+        let reports: [MenuHelpChildrenRead.Trace]
+    }
+
+    private static func array(_ items: [AnyObject]) -> CFArray {
+        var pointers: [UnsafeRawPointer?] = items.map { UnsafeRawPointer(Unmanaged.passUnretained($0).toOpaque()) }
+        var callbacks = kCFTypeArrayCallBacks
+        return pointers.withUnsafeMutableBufferPointer {
+            CFArrayCreate(kCFAllocatorDefault, $0.baseAddress, $0.count, &callbacks)!
+        }
+    }
+
+    private static func run(_ fixture: Fixture) -> Observation {
+        var calls: [String] = []
+        var reports: [MenuHelpChildrenRead.Trace] = []
+        var index = 0
+        let result = MenuHelpChildrenRead.read(leafAllowed: fixture.leafAllowed, limit: fixture.limit,
+            count: { calls.append("count"); return (fixture.countError, fixture.count) },
+            canCopy: { calls.append("canCopy"); return fixture.canCopy },
+            copy: { requested in calls.append("copy:\(requested)"); return (fixture.copyError, fixture.array) },
+            decode: { value in calls.append("decode"); return fixture.decodeFails ? nil : (value as? [AnyObject]) },
+            isElement: { value in
+                calls.append("element:\(index)"); index += 1
+                return CFGetTypeID(value as CFTypeRef) == AXUIElementGetTypeID()
+            }, report: { reports.append($0); calls.append("report") })
+        let kind: ResultKind
+        switch result {
+        case .value(let elements): kind = .values(elements.count)
+        case .unavailable: kind = .unavailable
+        case .failure: kind = .failure
+        }
+        return Observation(result: kind, calls: calls, reports: reports)
+    }
+
+    static func run() throws {
+        func check(_ condition: @autoclosure () -> Bool, _ message: String) throws {
+            guard condition() else {
+                throw NSError(domain: "TileLauncher.MenuHelpChildrenReadValidation", code: 1,
+                              userInfo: [NSLocalizedDescriptionKey: message])
+            }
+        }
+        func failed(_ observation: Observation, _ failure: MenuHelpChildrenRead.Failure,
+                    result: ResultKind = .failure, calls: [String]) throws -> MenuHelpChildrenRead.Trace {
+            try check(observation.result == result, "Diagnostic reader changed the child read outcome")
+            try check(observation.calls == calls, "A failure added/reordered reads or continued after its first rejected stage")
+            try check(observation.reports.count == 1, "Each failed child read must report exactly once")
+            guard let trace = observation.reports.first else {
+                throw NSError(domain: "TileLauncher.MenuHelpChildrenReadValidation", code: 2)
+            }
+            try check(trace.failure == failure, "Incorrect first failure stage")
+            return trace
+        }
+        func noCopyFields(_ trace: MenuHelpChildrenRead.Trace) throws {
+            try check(trace.copyErrorCode == nil && trace.requestedCount == nil
+                      && trace.returnedCount == nil && trace.invalidIndex == nil,
+                      "A child read reported data from a stage it never reached")
+        }
+
+        // These create handles without querying accessibility or another app.
+        let handle = AXUIElementCreateApplication(getpid())
+        let two = array([handle, handle])
+        let one = array([handle])
+        let three = array([handle, handle, handle])
+        var fixture = Fixture(array: two)
+
+        let success = run(fixture)
+        try check(success.result == .values(2) && success.reports.isEmpty,
+                  "A complete valid array must keep its normal successful outcome")
+        try check(success.calls == ["count", "canCopy", "copy:2", "decode", "element:0", "element:1"],
+                  "The successful child reader must issue only one count and one copy")
+
+        fixture.count = 0
+        let empty = run(fixture)
+        try check(empty.result == .values(0) && empty.calls == ["count"] && empty.reports.isEmpty,
+                  "An explicit empty child count must not copy, decode or report a failure")
+
+        fixture = Fixture(countError: .attributeUnsupported, array: nil)
+        fixture.leafAllowed = true
+        let leaf = run(fixture)
+        try check(leaf.result == .values(0) && leaf.calls == ["count"] && leaf.reports.isEmpty,
+                  "Explicit unsupported children on a known menu item retain leaf compatibility")
+        fixture.leafAllowed = false
+        let unsupported = try failed(run(fixture), .countUnavailable, result: .unavailable, calls: ["count", "report"])
+        try check(unsupported == .init(failure: .countUnavailable,
+                                      countErrorCode: Int(AXError.attributeUnsupported.rawValue)),
+                  "Unavailable children must report only the failing count error")
+        try noCopyFields(unsupported)
+        fixture.countError = .noValue; fixture.leafAllowed = true
+        let absent = try failed(run(fixture), .countUnavailable, result: .unavailable, calls: ["count", "report"])
+        try check(absent == .init(failure: .countUnavailable, countErrorCode: Int(AXError.noValue.rawValue)),
+                  "noValue was confused with attributeUnsupported or reported an unread count")
+        try noCopyFields(absent)
+
+        fixture = Fixture(countError: .cannotComplete, count: -1, array: two)
+        let countError = try failed(run(fixture), .countError, calls: ["count", "report"])
+        try check(countError == .init(failure: .countError, countErrorCode: Int(AXError.cannotComplete.rawValue)),
+                  "An error must not expose the invalid output count from its failed API call")
+        try noCopyFields(countError)
+        fixture.countError = .success
+        let negative = try failed(run(fixture), .negativeCount, calls: ["count", "report"])
+        try check(negative == .init(failure: .negativeCount, reportedCount: -1),
+                  "A negative successful count must be distinct from an AX error")
+        try noCopyFields(negative)
+
+        fixture = Fixture(canCopy: false, array: two)
+        let skipped = try failed(run(fixture), .copyNotAttempted, calls: ["count", "canCopy", "report"])
+        try check(skipped == .init(failure: .copyNotAttempted, reportedCount: 2),
+                  "An unattempted copy must retain only the preceding valid count")
+        try noCopyFields(skipped)
+
+        fixture = Fixture(copyError: .cannotComplete, array: nil)
+        let copyError = try failed(run(fixture), .copyError, calls: ["count", "canCopy", "copy:2", "report"])
+        try check(copyError == .init(failure: .copyError, copyErrorCode: Int(AXError.cannotComplete.rawValue),
+                                    reportedCount: 2, requestedCount: 2),
+                  "Copy errors must retain their actual request and AX error")
+        try check(copyError.returnedCount == nil && copyError.invalidIndex == nil, "Failed copies have no decoded array")
+        fixture.copyError = .success
+        let missing = try failed(run(fixture), .missingArray, calls: ["count", "canCopy", "copy:2", "report"])
+        try check(missing == .init(failure: .missingArray, reportedCount: 2, requestedCount: 2),
+                  "A successful nil array is not an IPC error or a valid empty list")
+
+        fixture = Fixture(array: two, decodeFails: true)
+        let undecodable = try failed(run(fixture), .arrayDecode, calls: ["count", "canCopy", "copy:2", "decode", "report"])
+        try check(undecodable == .init(failure: .arrayDecode, reportedCount: 2, requestedCount: 2),
+                  "A failed decode must not inspect elements or invent a decoded count")
+
+        fixture = Fixture(array: one)
+        let mismatch = try failed(run(fixture), .countMismatch, calls: ["count", "canCopy", "copy:2", "decode", "report"])
+        try check(mismatch == .init(failure: .countMismatch, reportedCount: 2, requestedCount: 2, returnedCount: 1),
+                  "Array count mismatches must stop before any element type reads")
+
+        fixture = Fixture(count: 3, array: array([handle, NSString(string: "private fixture value"), handle]))
+        let badType = try failed(run(fixture), .elementType,
+                                 calls: ["count", "canCopy", "copy:3", "decode", "element:0", "element:1", "report"])
+        try check(badType == .init(failure: .elementType, reportedCount: 3, requestedCount: 3,
+                                  returnedCount: 3, invalidIndex: 1),
+                  "The first invalid element index must be reported without inspecting later elements")
+        try check(!String(reflecting: badType).contains("private fixture value"),
+                  "The trace must not retain or expose an AX array value")
+
+        fixture = Fixture(limit: 2, count: 500, array: three)
+        let limited = run(fixture)
+        try check(limited.result == .values(3) && limited.reports.isEmpty,
+                  "The reader must let the existing traversal reject cap+1 as childLimit")
+        try check(limited.calls == ["count", "canCopy", "copy:3", "decode", "element:0", "element:1", "element:2"],
+                  "An oversized count must request only the existing cap+1, never the full count")
+
+        print("Menu Help children diagnostic: injected actual read path preserves query order and outcomes; count/copy errors, missing/decode/count/type failures and cap+1 distinguished without AX queries.")
+    }
+}
