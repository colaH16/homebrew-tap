+        var reason: MenuCaptureGate.DiagnosticOutcome?
+        func take(_ time: TimeInterval, _ match: Bool, _ expected: MenuCaptureGate.DiagnosticOutcome) {
+            let result = traced.take(menu, matchedUserSelection: match, time: time, preferences: .init(), diagnostic: { reason = $0 })
+            XCTAssertEqual(result, normal.take(menu, matchedUserSelection: match, time: time, preferences: .init()))
+            switch (reason, expected) {
+            case (.unarmed, .unarmed), (.beforeArm, .beforeArm), (.unmatched, .unmatched),
+                 (.accepted, .accepted), (.consumed, .consumed), (.expired, .expired): break
+            default: XCTFail("Incorrect physical gate reason")
+            }
+        }
+        take(1, true, .unarmed)
+        normal.arm(time: 2); traced.arm(time: 2)
+        take(1.9, true, .beforeArm)
+        take(2.1, false, .unmatched)
+        take(2.2, true, .accepted)
+        take(2.3, true, .consumed)
+        normal.arm(time: 3); traced.arm(time: 3)
+        take(3.9, true, .expired)
+        normal.cancel(); traced.cancel()
+        take(4, true, .unarmed)
+    }
+    #endif
+}
diff --git a/Tests/DeckCoreTests/MenuCatalogTraversalTests.swift b/Tests/DeckCoreTests/MenuCatalogTraversalTests.swift
new file mode 100644
index 0000000..af944b7
--- /dev/null
+++ b/Tests/DeckCoreTests/MenuCatalogTraversalTests.swift
@@ -0,0 +1,193 @@
+import XCTest
+@testable import DeckCore
+
+final class MenuCatalogTraversalTests: XCTestCase {
+    private enum Fault { case none, unavailable, failure }
+    private final class Node {
+        let id: Int
+        var role: MenuCatalogTraversal.Role
+        var title: String
+        var children: [Node]
+        var roleFault = Fault.none
+        var titleFault = Fault.none
+        var childrenFault = Fault.none
+        init(_ id: Int, _ role: MenuCatalogTraversal.Role, _ title: String = "", _ children: [Node] = []) {
+            self.id = id; self.role = role; self.title = title; self.children = children
+        }
+    }
+    private typealias Traversal = MenuCatalogTraversal
+    private func read<Value>(_ value: Value, fault: Fault) -> Traversal.Read<Value> {
+        switch fault {
+        case .none: return .value(value)
+        case .unavailable: return .unavailable
+        case .failure: return .failure
+        }
+    }
+    private func run(_ roots: [Traversal.Root<Node>], rootFault: Fault = .none,
+                     limits: Traversal.Limits = .init(), hasTime: () -> Bool = { true },
+                     cancelled: () -> Bool = { false },
+                     didRead: ((Traversal.Attribute) -> Void)? = nil) -> (Traversal.Outcome<Node>, [String]) {
+        var calls: [String] = []
+        let result = Traversal.scan(roots: {
+            calls.append("roots"); didRead?(.roots)
+            return self.read(roots, fault: rootFault)
+        }, role: { node in
+            calls.append("role:\(node.id)"); didRead?(.role)
+            return self.read(node.role, fault: node.roleFault)
+        }, title: { node in
+            calls.append("title:\(node.id)"); didRead?(.title)
+            if node.role == .container { XCTFail("Optional container titles must never be read") }
+            return self.read(node.title, fault: node.titleFault)
+        }, children: { node in
+            calls.append("children:\(node.id)"); didRead?(.children)
+            return self.read(node.children, fault: node.childrenFault)
+        }, hasTime: hasTime, isCancelled: cancelled, limits: limits)
+        return (result, calls)
+    }
+    private func failure(_ value: Traversal.Outcome<Node>, file: StaticString = #filePath, line: UInt = #line) -> Traversal.Failure? {
+        switch value {
+        case .incomplete(let reason, _): return reason
+        case .complete: XCTFail("A partial tree must not be exposed as complete", file: file, line: line); return nil
+        }
+    }
+    private func simple() -> (root: Node, container: Node, leaf: Node) {
+        let leaf = Node(3, .menuItem, "PDF…")
+        let container = Node(2, .container, "", [leaf])
+        let root = Node(1, .menuBarItem, "File", [container])
+        return (root, container, leaf)
+    }
+    func testCompleteTreePreservesEveryPathAndSkipsOnlyProvenExcludedSubtrees() throws {
+        let unreadable = Node(99, .menuItem, "never read")
+        unreadable.roleFault = .failure
+        let apple = Node(0, .menuBarItem, "localized Apple", [unreadable])
+        apple.roleFault = .failure
+        let help = Node(10, .menuBarItem, "도움말", [unreadable])
+        help.childrenFault = .failure
+        let pdf = Node(3, .menuItem, "PDF…")
+        let export = Node(2, .menuItem, "Export To", [Node(4, .container, "", [pdf])])
+        let literal = Node(5, .menuItem, "Export To > PDF…")
+        let separator = Node(6, .menuItem)
+        let insideHelp = Node(7, .menuItem, "Help", [Node(8, .container, "", [Node(9, .menuItem, "Guide")])])
+        let file = Node(1, .menuBarItem, "File", [Node(11, .container, "", [export, literal, separator, insideHelp])])
+        let (outcome, calls) = run([.init(node: apple, isAppleMenu: true), .init(node: file), .init(node: help)])
+        guard case .complete(let entries, let statistics) = outcome else { return XCTFail("Complete structural fixture rejected") }
+        XCTAssertEqual(entries.map(\.path), [["File", "Export To", "PDF…"], ["File", "Export To > PDF…"], ["File", "Help", "Guide"]])
+        XCTAssertEqual(entries.map { $0.node.id }, [3, 5, 9])
+        XCTAssertFalse(calls.contains("role:0"))
+        XCTAssertFalse(calls.contains("role:99"))
+        XCTAssertFalse(calls.contains("children:10"))
+        XCTAssertFalse(calls.contains("title:11"))
+        XCTAssertEqual(statistics.rootReads, 1)
+        XCTAssertEqual(statistics.roleReads, statistics.nodes)
+        // Structural completion must preserve both literal/breadcrumb candidates,
+        // leaving the existing global ambiguity policy to reject the collision.
+        let choices = entries.map { CapturedMenu(appID: "fixture", appName: "Fixture", path: $0.path) }
+        XCTAssertNil(MenuCapturePolicy.resolveHelp(title: "Export To > PDF…", choices: choices))
+    }
+    func testMandatoryReadFailuresCannotProducePartialCatalogs() {
+        for fault in [Fault.unavailable, .failure] {
+            let f = simple()
+            for attribute in [Traversal.Attribute.roots, .role, .title, .children] {
+                f.root.roleFault = .none; f.root.titleFault = .none; f.root.childrenFault = .none
+                switch attribute {
+                case .roots: break
+                case .role: f.root.roleFault = fault
+                case .title: f.root.titleFault = fault
+                case .children: f.root.childrenFault = fault
+                }
+                let (outcome, _) = run([.init(node: f.root)], rootFault: attribute == .roots ? fault : .none)
+                let expected: Traversal.Failure = fault == .unavailable ? .unavailable(attribute) : .readFailure(attribute)
+                XCTAssertEqual(failure(outcome), expected)
+            }
+        }
+        let f = simple()
+        let missing = Node(4, .menuItem, "Unreadable")
+        missing.childrenFault = .failure
+        f.container.children.append(missing)
+        let (afterValidEntry, _) = run([.init(node: f.root)])
+        XCTAssertEqual(failure(afterValidEntry), .readFailure(.children), "An earlier valid command must not escape an incomplete result")
+    }
+    func testSuccessfulEmptySeparatorDiffersFromMissingTitleAndUnnamedBranch() {
+        let f = simple()
+        f.leaf.title = ""
+        let (separator, _) = run([.init(node: f.root)])
+        guard case .complete(let entries, _) = separator else { return XCTFail("Explicit childless separator rejected") }
+        XCTAssertTrue(entries.isEmpty)
+        f.leaf.titleFault = .unavailable
+        XCTAssertEqual(failure(run([.init(node: f.root)]).0), .unavailable(.title))
+        f.leaf.titleFault = .none
+        f.leaf.children = [Node(4, .menuItem, "Child")]
+        XCTAssertEqual(failure(run([.init(node: f.root)]).0), .unnamedBranch)
+        f.root.title = ""
+        XCTAssertEqual(failure(run([.init(node: f.root)]).0), .unnamedBranch)
+    }
+    func testKnownContainersNeedNoTitleButUnknownOrInvalidRootCannotBeIgnored() {
+        let f = simple()
+        f.container.titleFault = .failure
+        guard case .complete = run([.init(node: f.root)]).0 else { return XCTFail("A structural container needs no title") }
+        f.container.roleFault = .unavailable
+        XCTAssertEqual(failure(run([.init(node: f.root)]).0), .unavailable(.role))
+        f.root.role = .container
+        XCTAssertEqual(failure(run([.init(node: f.root)]).0), .invalidRootRole)
+    }
+    func testCapsUseStructuralNodesAndDoNotExposeCandidatesFromTruncatedTrees() {
+        let f = simple()
+        guard case .complete(let entries, _) = run([.init(node: f.root)], limits: .init(nodes: 3, children: 1, depth: 3)).0 else {
+            return XCTFail("Exact cap boundary should succeed")
+        }
+        XCTAssertEqual(entries.count, 1)
+        XCTAssertEqual(failure(run([.init(node: f.root)], limits: .init(nodes: 2)).0), .nodeLimit)
+        XCTAssertEqual(failure(run([.init(node: f.root)], limits: .init(depth: 2)).0), .depthLimit)
+        XCTAssertEqual(failure(run([.init(node: f.root), .init(node: Node(9, .menuBarItem, "Other"))],
+                                   limits: .init(children: 1)).0), .childLimit)
+        f.container.children.append(Node(4, .menuItem, "Other"))
+        XCTAssertEqual(failure(run([.init(node: f.root)], limits: .init(children: 1)).0), .childLimit)
+    }
+    func testDeadlineAndCancellationBeforeAndAfterEveryReaderStopFurtherReads() {
+        let f = simple()
+        let before = run([.init(node: f.root)], hasTime: { false })
+        XCTAssertEqual(failure(before.0), .deadline)
+        XCTAssertTrue(before.1.isEmpty)
+        let cancelled = run([.init(node: f.root)], cancelled: { true })
+        XCTAssertEqual(failure(cancelled.0), .cancelled)
+        XCTAssertTrue(cancelled.1.isEmpty)
+        for attribute in [Traversal.Attribute.roots, .role, .title, .children] {
+            var timeRemains = true
+            let result = run([.init(node: f.root)], hasTime: { timeRemains }, didRead: {
+                if $0 == attribute { timeRemains = false }
+            })
+            XCTAssertEqual(failure(result.0), .deadline)
+            var cancel = false
+            let stopped = run([.init(node: f.root)], cancelled: { cancel }, didRead: {
+                if $0 == attribute { cancel = true }
+            })
+            XCTAssertEqual(failure(stopped.0), .cancelled)
+            XCTAssertEqual(result.1, stopped.1)
+            let expectedLast: String
+            switch attribute {
+            case .roots: expectedLast = "roots"
+            case .role: expectedLast = "role:1"
+            case .title: expectedLast = "title:1"
+            case .children: expectedLast = "children:1"
+            }
+            XCTAssertEqual(result.1.last, expectedLast)
+        }
+    }
+    func testEmptyCompleteCatalogAndInvalidConfigurationAreDistinctFromFailure() {
+        guard case .complete(let entries, let statistics) = run([]).0 else { return XCTFail("Empty roots can be complete") }
+        XCTAssertTrue(entries.isEmpty)
+        XCTAssertEqual(statistics.rootReads, 1)
+        let f = simple()
+        for limits in [Traversal.Limits(nodes: 0), .init(children: 0), .init(depth: 0)] {
+            let (outcome, calls) = run([.init(node: f.root)], limits: limits)
+            XCTAssertEqual(failure(outcome), .invalidLimits)
+            XCTAssertTrue(calls.isEmpty)
+        }
+    }
+    func testCyclesAreBoundedAndNeverReportedAsComplete() {
+        let f = simple()
+        f.container.children = [f.container]
+        defer { f.container.children = [] }
+        XCTAssertEqual(failure(run([.init(node: f.root)], limits: .init(nodes: 10, depth: 5)).0), .depthLimit)
+    }
+}
diff --git a/Tests/DeckCoreTests/MenuDeferredCaptureTests.swift b/Tests/DeckCoreTests/MenuDeferredCaptureTests.swift
new file mode 100644
index 0000000..e01010e
--- /dev/null
+++ b/Tests/DeckCoreTests/MenuDeferredCaptureTests.swift
@@ -0,0 +1,112 @@
+import XCTest
+@testable import DeckCore
+
+final class MenuDeferredCaptureTests: XCTestCase {
+    func testNormalClosePreservesConfirmedSelectionBeyondNotificationGate() throws {
+        var policy = MenuDeferredCapture()
+        let ticket = try XCTUnwrap(policy.confirm(generation: 7, at: 100))
+        policy.menuClosed()
+        policy.menuClosed()
+        XCTAssertEqual(ticket.confirmedAt, 100)
+        XCTAssertEqual(ticket.expiresAt, 102)
+        // Native row/release confirmation has already happened. Resolver time is
+        // its own bounded lifetime, not a second 0.8-second notification gate.
+        XCTAssertTrue(policy.isCurrent(ticket, generation: 7, at: 100.9))
+        XCTAssertTrue(policy.take(ticket, generation: 7, at: 101.8))
+        XCTAssertNil(policy.pending)
+        XCTAssertFalse(policy.take(ticket, generation: 7, at: 101.9))
+    }
+
+    func testNewSelectionSupersedesOldResultWithoutConsumingNewTicket() throws {
+        var policy = MenuDeferredCapture()
+        let first = try XCTUnwrap(policy.confirm(generation: 3, at: 1))
+        let second = try XCTUnwrap(policy.confirm(generation: 3, at: 1.2))
+        XCTAssertGreaterThan(second.id, first.id)
+        XCTAssertFalse(policy.isCurrent(first, generation: 3, at: 1.3))
+        XCTAssertFalse(policy.take(first, generation: 3, at: 1.3))
+        XCTAssertEqual(policy.pending, second)
+        XCTAssertTrue(policy.take(second, generation: 3, at: 1.4))
+        XCTAssertFalse(policy.take(second, generation: 3, at: 1.5))
+        let third = try XCTUnwrap(policy.confirm(generation: 4, at: 2))
+        XCTAssertGreaterThan(third.id, second.id, "A generation change must not reset request IDs")
+    }
+
+    func testCancelInvalidatesWhenGenerationDoesNotChangeAndDoesNotResetIDs() throws {
+        var policy = MenuDeferredCapture()
+        let first = try XCTUnwrap(policy.confirm(generation: 9, at: 10))
+        // New input, settings cancellation, explicit cancel and stop all use
+        // this transition, even if the same app/process remains frontmost.
+        policy.cancel()
+        XCTAssertNil(policy.pending)
+        policy.menuClosed()
+        XCTAssertFalse(policy.isCurrent(first, generation: 9, at: 10.1))
+        XCTAssertFalse(policy.take(first, generation: 9, at: 10.1))
+        let next = try XCTUnwrap(policy.confirm(generation: 9, at: 11))
+        XCTAssertGreaterThan(next.id, first.id)
+        XCTAssertTrue(policy.take(next, generation: 9, at: 11.1))
+    }
+
+    func testProcessGenerationMismatchAndAppSwitchRejectStaleCompletion() throws {
+        var policy = MenuDeferredCapture()
+        let old = try XCTUnwrap(policy.confirm(generation: 40, at: 20))
+        XCTAssertFalse(policy.isCurrent(old, generation: 41, at: 20.1))
+        XCTAssertFalse(policy.take(old, generation: 41, at: 20.1))
+        // The native adapter calls cancel on process/generation changes.
+        policy.cancel()
+        let current = try XCTUnwrap(policy.confirm(generation: 41, at: 20.2))
+        XCTAssertFalse(policy.take(old, generation: 40, at: 20.3))
+        XCTAssertEqual(policy.pending, current)
+        XCTAssertTrue(policy.take(current, generation: 41, at: 20.4))
+    }
+
+    func testConfirmationAndExpiryBoundariesAreInclusive() throws {
+        let before = TimeInterval(10).nextDown
+        let after = TimeInterval(12).nextUp
+        for (now, expected) in [(before, false), (10.0, true), (11.0, true), (12.0, true), (after, false)] {
+            var policy = MenuDeferredCapture()
+            let ticket = try XCTUnwrap(policy.confirm(generation: 2, at: 10))
+            XCTAssertEqual(policy.isCurrent(ticket, generation: 2, at: now), expected)
+            XCTAssertEqual(policy.take(ticket, generation: 2, at: now), expected)
+        }
+    }
+
+    func testInvalidNewConfirmationFailsClosedRatherThanLeavingOldTicketAlive() throws {
+        let invalid: [(TimeInterval, TimeInterval)] = [
+            (.nan, 2), (.infinity, 2), (-.infinity, 2), (-1, 2),
+            (2, .nan), (2, .infinity), (2, -.infinity), (2, 0), (2, -1),
+            (.greatestFiniteMagnitude, .greatestFiniteMagnitude),
+            (.greatestFiniteMagnitude, 1), // Rounded expiry would equal confirmation.
+        ]
+        for (time, duration) in invalid {
+            var policy = MenuDeferredCapture()
+            let old = try XCTUnwrap(policy.confirm(generation: 1, at: 1))
+            XCTAssertNil(policy.confirm(generation: 1, at: time, duration: duration))
+            XCTAssertNil(policy.pending)
+            XCTAssertFalse(policy.take(old, generation: 1, at: 1.1))
+            let next = try XCTUnwrap(policy.confirm(generation: 1, at: 2))
+            XCTAssertGreaterThan(next.id, old.id)
+        }
+    }
+
+    func testInvalidCompletionTimeCannotConsumeAnOtherwiseCurrentRequest() throws {
+        var policy = MenuDeferredCapture()
+        let ticket = try XCTUnwrap(policy.confirm(generation: 8, at: 1))
+        for now: TimeInterval in [.nan, .infinity, -.infinity, -1, 0] {
+            XCTAssertFalse(policy.isCurrent(ticket, generation: 8, at: now))
+            XCTAssertFalse(policy.take(ticket, generation: 8, at: now))
+            XCTAssertEqual(policy.pending, ticket)
+        }
+        XCTAssertTrue(policy.take(ticket, generation: 8, at: 1.1))
+    }
+
+    func testCopiedIDCannotExtendDeadlineOrChangeConfirmationMetadata() throws {
+        var policy = MenuDeferredCapture()
+        let ticket = try XCTUnwrap(policy.confirm(generation: 5, at: 10))
+        let altered = MenuDeferredCapture.Ticket(id: ticket.id, generation: ticket.generation,
+                                                confirmedAt: ticket.confirmedAt, expiresAt: ticket.expiresAt + 100)
+        XCTAssertFalse(policy.isCurrent(altered, generation: 5, at: 11))
+        XCTAssertFalse(policy.take(altered, generation: 5, at: 11))
+        XCTAssertEqual(policy.pending, ticket)
+        XCTAssertTrue(policy.take(ticket, generation: 5, at: 11))
+    }
+}
diff --git a/Tests/DeckCoreTests/MenuDiagnosticsBuildTests.swift b/Tests/DeckCoreTests/MenuDiagnosticsBuildTests.swift
new file mode 100644
index 0000000..482bd4f
--- /dev/null
+++ b/Tests/DeckCoreTests/MenuDiagnosticsBuildTests.swift
@@ -0,0 +1,68 @@
+import Foundation
+import XCTest
+
+final class MenuDiagnosticsBuildTests: XCTestCase {
+    /// Runs only shell/argument plumbing. Both swift calls are stubs; the first
+    /// copy is another stub that stops before metadata, xattr or signing steps.
+    private func options(_ option: String?) throws -> (status: Int32, calls: String) {
+        let fm = FileManager.default
+        let directory = fm.temporaryDirectory.appendingPathComponent("tile-menu-build-options-" + UUID().uuidString)
+        try fm.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? fm.removeItem(at: directory) }
+        let bin = directory.appendingPathComponent("bin")
+        try fm.createDirectory(at: bin, withIntermediateDirectories: true)
+        let swift = bin.appendingPathComponent("swift")
+        try """
+        #!/bin/bash
+        printf '%s\\n' '@call' "$@" >> "$TILE_LAUNCHER_TEST_SWIFT_ARGUMENTS"
+        for option in "$@"; do
+            if [[ "$option" == '--show-bin-path' ]]; then
+                printf '%s\\n' "$TILE_LAUNCHER_TEST_BINARY_DIRECTORY"
+            fi
+        done
+        exit 0
+        """.write(to: swift, atomically: true, encoding: .utf8)
+        let copy = bin.appendingPathComponent("cp")
+        try "#!/bin/bash\nexit 73\n".write(to: copy, atomically: true, encoding: .utf8)
+        for path in [swift, copy] { try fm.setAttributes([.posixPermissions: 0o700], ofItemAtPath: path.path) }
+        let args = directory.appendingPathComponent("arguments.txt")
+        let repository = URL(fileURLWithPath: #filePath).deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/bin/bash")
+        process.arguments = [repository.appendingPathComponent("scripts/build.sh").path]
+        process.currentDirectoryURL = repository
+        var environment = ProcessInfo.processInfo.environment
+        environment.removeValue(forKey: "BASH_ENV")
+        environment.removeValue(forKey: "ENV")
+        environment["PATH"] = bin.path + ":" + (environment["PATH"] ?? "/usr/bin:/bin")
+        environment["TILE_LAUNCHER_TEST_SWIFT_ARGUMENTS"] = args.path
+        environment["TILE_LAUNCHER_TEST_BINARY_DIRECTORY"] = bin.path
+        environment["TILE_LAUNCHER_OUTPUT_DIR"] = directory.appendingPathComponent("synthetic-products").path
+        environment["TILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS"] = option
+        process.environment = environment
+        let output = Pipe()
+        process.standardOutput = output
+        process.standardError = output
+        try process.run()
+        process.waitUntilExit()
+        _ = output.fileHandleForReading.readDataToEndOfFile()
+        return (process.terminationStatus, (try? String(contentsOf: args, encoding: .utf8)) ?? "")
+    }
+    func testDiagnosticFlagIsExplicitAndAppliedToBuildAndBinPath() throws {
+        let flag = "-DTILE_LAUNCHER_MENU_CAPTURE_DIAGNOSTICS"
+        for option in [nil, "0", "1"] as [String?] {
+            let result = try options(option)
+            XCTAssertEqual(result.status, 73, "The stub copy stops before every signing/install step")
+            let calls = result.calls.split(separator: "\n").map(String.init)
+            XCTAssertEqual(calls.filter { $0 == "@call" }.count, 2)
+            XCTAssertEqual(calls.filter { $0 == "--show-bin-path" }.count, 1)
+            XCTAssertEqual(calls.filter { $0 == flag }.count, option == "1" ? 2 : 0)
+            XCTAssertEqual(calls.filter { $0 == "-Xswiftc" }.count, option == "1" ? 2 : 0)
+        }
+    }
+    func testInvalidDiagnosticFlagStopsBeforeAnyBuild() throws {
+        let result = try options("yes")
+        XCTAssertEqual(result.status, 2)
+        XCTAssertTrue(result.calls.isEmpty)
+    }
+}
