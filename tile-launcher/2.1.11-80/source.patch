+        let table = Node(0, .table); table.path = ["Help"]
+        let row = Node(1, .row); row.parent = table; table.children = [row]
+        row.frame = CGRect(x: -900, y: 120, width: 360, height: 24)
+        let cell = Node(2, .cell); cell.parent = row; row.children = [cell]
